{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Host": "127.0.0.1",
    "Port": 1433,
    "User": "sa",
    "Encrypt": true
  },
  "Dashboard": {
    "UpcomingDays": 7,
    "UpcomingLimit": 10
  },
  "Notifications": {
    "RetentionDays": 7,
    "ListLimit": 50,
    "HeartbeatSeconds": 25,
    "CleanupIntervalMinutes": 60,
    "RedisChannel": "notifications"
  },
  "Email": {
    "Host": "localhost",
    "Port": 587,
    "UseTls": true,
    "FromAddress": "notifications@example.com",
    "FromName": "Task notifications",
    "AppBaseUrl": "https://localhost",
    "TaskPathTemplate": "/tasks/{id}",
    "ProjectPathTemplate": "/projects/{id}",
    "PollSeconds": 10,
    "BatchSize": 20,
    "ClaimSeconds": 120,
    "MaxAttempts": 5
  },
  "Paging": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100
  },
  "Jwt": {
    "Issuer": "local-dev-issuer",
    "Audience": "local-dev-audience",
    "AccessTokenMinutes": 10
  },
  "Redis": {
    "TokenVersionTtlMinutes": 60,
    "ConnectTimeoutMs": 2000,
    "OperationTimeoutMs": 1000
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  }
}

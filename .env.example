# Single source of truth for Docker Compose and the verify script.
# Copy to .env (git-ignored) for Docker Compose.
# For `dotnet run`, copy the secrets into user-secrets (see README).
# All values below are SAFE DEV-ONLY placeholders, never real secrets.

# Naming. IMAGE_NAME = lowercase PROJECT_NAME. DB_NAME = PROJECT_NAME.
PROJECT_NAME=SmartTaskManagement
IMAGE_NAME=smarttaskmanagement
DB_NAME=SmartTaskManagement

# Assembly started by the Docker image entrypoint (Dockerfile build ARG).
APP_ASSEMBLY=Datavanced.SmartTaskManagement.Api

# SQL Server image, pinned (verified on mcr.microsoft.com 2026-11-08).
# Single source for docker-compose.yml AND the Testcontainers fixture.
SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-CU27-GDR1-ubuntu-22.04

# Host port of the local SQL Server container.
DB_PORT=1433

# Host port of the api container (docker compose, local only).
API_PORT=5080

# SQL Server SA password for the local container (dev only).
DB_PASSWORD=Dev_Only_Passw0rd!

# JWT signing key, at least 32 characters (dev only).
JWT_SIGNING_KEY=dev-only-signing-key-change-me-0123456789

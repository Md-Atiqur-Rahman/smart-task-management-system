<Project>

  <!--
    The ONLY place where the two naming inputs are defined.
    Everything else (assembly names, namespaces) derives from them.
  -->
  <PropertyGroup>
    <COMPANY_NAME>Datavanced</COMPANY_NAME>
    <PROJECT_NAME>SmartTaskManagement</PROJECT_NAME>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Folder name = csproj name, so MSBuildProjectName is the layer name. -->
    <AssemblyName>$(COMPANY_NAME).$(PROJECT_NAME).$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>$(COMPANY_NAME).$(PROJECT_NAME).$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>

    <!-- Quality gates: identical in every configuration. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      The only globally disabled rules (all others are scoped, see docs/coding-standards.md):
      CA2007: ASP.NET Core has no SynchronizationContext, ConfigureAwait adds noise only.
      CS1591: XML docs are generated for IDE help, not required on every public member.
      CA1062: NullGuard.Fody plus Nullable reference types cover argument null checks.
    -->
    <NoWarn>$(NoWarn);CA2007;CS1591;CA1062</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>

{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Host": "127.0.0.1",
    "Port": 1433,
    "User": "sa",
    "Encrypt": true
  },
  "Paging": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100
  },
  "Jwt": {
    "Issuer": "local-dev-issuer",
    "Audience": "local-dev-audience"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  }
}

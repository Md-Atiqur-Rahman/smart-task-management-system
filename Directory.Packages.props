<Project>

  <!--
    Central Package Management: the ONLY place where package versions live.
    Every version is verified with "dotnet package search" (exact-match option)
    before it is added (No-Hallucination Policy).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a PackageVersion below raise a TRANSITIVE dependency to a patched version. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Security pins for transitive dependencies (NuGetAudit failed the build).
    System.Security.Cryptography.Pkcs: Microsoft.Data.SqlClient 6.1.7 (via EF Core
    SqlServer 10.0.14) pulls 9.0.11, affected by GHSA-846f-f764-76mx (high) and
    GHSA-2fmv-rv2c-59x7 (moderate); patched in 10.0.13. Even SqlClient 7.1.1 only
    requires >= 9.0.18. Remove the pin when EF Core brings a patched version.
  -->
  <ItemGroup>
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <!-- Null safety (weaving). Verified 2026-11-08: Fody 6.9.3 MIT, NullGuard.Fody 3.1.1 MIT. -->
  <ItemGroup>
    <PackageVersion Include="Fody" Version="6.9.3" />
    <PackageVersion Include="NullGuard.Fody" Version="3.1.1" />
  </ItemGroup>

  <!-- Application. Verified 2026-11-08 (latest stable, no advisories). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.14" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
  </ItemGroup>

  <!-- Infrastructure. Verified 2026-11-08 (latest stable, no advisories). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.14" />
    <!-- Verified 2026-11-09: 8.19.2 listed on nuget.org (MIT); same version JwtBearer/SqlClient already resolve, no advisory (NuGetAudit clean). -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
  </ItemGroup>

  <!-- Api. Verified 2026-11-08 (latest stable, no advisories). -->
  <ItemGroup>
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.14" />
  </ItemGroup>

  <!-- Tests. Verified 2026-11-08 (latest stable, no advisories). -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>

</Project>
